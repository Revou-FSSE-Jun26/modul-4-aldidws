# =============================================================
# RevoTask Frontend — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# Backend ORIGIN only: scheme + host (+ port). No trailing slash and no /api.
# Request paths in the code already start with /api (for example /api/boards),
# so adding /api here would produce /api/api/boards.
# Inlined into the browser bundle at BUILD time: changing it needs a redeploy.
# Required on Vercel (the build fails if missing or malformed).
# Local: http://localhost:5000
# Vercel: https://your-service.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional, server-only. Same format as above. Used by Server Components;
# falls back to NEXT_PUBLIC_API_BASE_URL when unset. Not needed on Vercel.
API_BASE_URL=http://localhost:5000
# --------------- Playwright / E2E tests (optional) ---------------

# Target URL for the Next.js dev server during E2E runs
BASE_URL=http://localhost:3000

# Dedicated test account credentials (never use a real account)
TEST_USER_EMAIL=e2e-test@example.com
TEST_USER_PASSWORD=TestPass1!
