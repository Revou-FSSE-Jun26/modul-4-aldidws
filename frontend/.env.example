# =============================================================
# RevoTask Frontend — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# Base URL of the Flask API — exposed to the browser bundle.
# Used by Client Components and hooks.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Base URL of the Flask API — server-only (not exposed to browser).
# Used by Server Components (app/page.tsx, app/boards/[id]/page.tsx).
API_BASE_URL=http://localhost:5000

# --------------- Playwright / E2E tests (optional) ---------------

# Target URL for the Next.js dev server during E2E runs
BASE_URL=http://localhost:3000

# Dedicated test account credentials (never use a real account)
TEST_USER_EMAIL=e2e-test@example.com
TEST_USER_PASSWORD=TestPass1!
