# =============================================================
# RevoTask Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# Flask application entry point
FLASK_APP=wsgi:app

# Runtime environment: development | production | testing
FLASK_ENV=development

# Secret key used by Flask for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# JWT signing secret (keep separate from SECRET_KEY; rotate regularly)
JWT_SECRET_KEY=change-me-to-a-different-random-secret

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/revotask

# Test database (used by pytest; never point this at the production DB)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/revotask_test

# JWT access token lifetime in minutes (default: 15)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15

# JWT refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed CORS origins (comma-separated)
# Example: http://localhost:3000,https://revotask.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
