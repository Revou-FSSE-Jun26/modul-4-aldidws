# =============================================================
# RevoTask — Root .env.example
# Copy relevant sections to backend/app/.env and frontend/.env.local
# =============================================================

# ---- Backend ----
FLASK_APP=wsgi:app
# APP_ENV selects the config (production | development | testing). Production is the default when unset.
APP_ENV=development
# Legacy fallback, APP_ENV takes precedence
FLASK_ENV=development
# Railway injects PORT; gunicorn binds to it
PORT=5000
SECRET_KEY=replace-with-random-32-byte-secret
JWT_SECRET_KEY=replace-with-different-random-secret
# postgres:// is accepted and normalised; add ?sslmode=require for a public proxy URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/revotask
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/revotask_test
# Required in production. Comma-separated origins, no wildcard
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
BASE_URL=http://localhost:3000
TEST_USER_EMAIL=e2e-test@example.com
TEST_USER_PASSWORD=TestPass1!
