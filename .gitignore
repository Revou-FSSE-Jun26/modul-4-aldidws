# =============================================================
# RevoTask — Root .gitignore
# =============================================================

# ----- Environment & secrets ----------------------------------
.env
.env.*
.env.local
.env.production
.env.test
!.env.example

# ----- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ----- Test cache & coverage ----------------------------------
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
coverage/

# ----- Flask / Alembic ----------------------------------------
instance/
*.db
*.sqlite3

# ----- Node / Next.js -----------------------------------------
node_modules/
.next/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts

# ----- Playwright ---------------------------------------------
playwright-report/
test-results/
blob-report/
playwright/.cache/
playwright/.auth/

# ----- IDE & OS -----------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ----- Misc ---------------------------------------------------
*.log
*.log.*
*.pem
.vercel

# ----- AI agent working files (plans, reviews, reports) -------
.agents/
**/.agents/
